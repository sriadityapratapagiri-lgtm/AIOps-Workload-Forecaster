FROM python:3.10-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src/ /app/src/

# Expose port for Prometheus to scrape the custom forecast metrics
EXPOSE 8000

# Execute the online inference API
CMD ["uvicorn", "src.online_phase.load_estimator_api:app", "--host", "0.0.0.0", "--port", "8000"]